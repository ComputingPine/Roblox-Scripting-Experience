local module = {}

local plyr = game:GetService("Players").LocalPlayer
local plyrModule = require(plyr:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule"))
local camera = game.Workspace.CurrentCamera

local rE = game:GetService("ReplicatedStorage")
local uIS = game:GetService("UserInputService")
local cAS = game:GetService("ContextActionService")
local rS = game:GetService("RunService")
local events = rE:FindFirstChild("Events")

local bGUI = script.BillboardGui
local dashDistance = 100

local function hitBox()
	local char = plyr.Character
	local humRP = char:FindFirstChild("HumanoidRootPart")
	local part = Instance.new("Part")
	part.Parent = char
	part.Size = Vector3.new(10,10,10)
	part.CanCollide = false
	part.Massless = true
	part.CFrame = humRP.CFrame * CFrame.new(0,1,-5)
	part.Transparency = 1
	local weld = Instance.new("WeldConstraint")
	weld.Parent = char
	weld.Part0 = humRP
	weld.Part1 = part
	return part
end

local function potentialTargets(part)
	local plyrs = {}
	local ovrPrm = OverlapParams.new()
	ovrPrm.FilterType = Enum.RaycastFilterType.Exclude
	ovrPrm.FilterDescendantsInstances = {plyr.Character}
	local array = game.Workspace:GetPartsInPart(part, ovrPrm)
	for i,v in pairs(array) do
		if v.Name == "HumanoidRootPart" then
			if table.find(plyrs, v.Parent) == nil then
				table.insert(plyrs, v.Parent)
			end
		end
	end
	return plyrs
end

local function setTarget(target, v)
	if target.Value == nil then
		target.Value = v
	else
		if plyr:DistanceFromCharacter(v.PrimaryPart.CFrame.Position) < plyr:DistanceFromCharacter(target.Value.PrimaryPart.CFrame.Position) then
			target.Value = v
		end
	end
end

local function getTargets(part)
	local plyrs = potentialTargets(part)
	if #plyrs < 1 then return end
	local char = plyr.Character
	local allyTarget = char:FindFirstChild("GameStatus"):FindFirstChild("Ally")
	local enemyTarget = char:FindFirstChild("GameStatus"):FindFirstChild("Enemy")
	allyTarget.Value = nil
	enemyTarget.Value = nil
	for i,v in pairs(plyrs) do
		if char:FindFirstChild("GameStatus"):GetAttribute("Team") == v:FindFirstChild("GameStatus"):GetAttribute("Team") then
			setTarget(allyTarget, v)
		else
			setTarget(enemyTarget, v)
		end
	end
end

local function punch(event, inputState, inputObj)
	local gameStatus = plyr.Character:FindFirstChild("GameStatus")
	if inputState ~= Enum.UserInputState.Begin or gameStatus:FindFirstChild("Enemy").Value == nil or gameStatus:GetAttribute("KO") or 
		gameStatus:GetAttribute("Punch") or gameStatus:GetAttribute("Rez") or gameStatus:GetAttribute("Rezzing") 
	then return end
	events:FindFirstChild("Punch"):FireServer(gameStatus:FindFirstChild("Enemy").Value)
end
