local function rez(event, inputState, inputObj)
	local gameStatus = plyr.Character:FindFirstChild("GameStatus")
	if inputState ~= Enum.UserInputState.Begin or gameStatus:FindFirstChild("Ally").Value == nil or gameStatus:GetAttribute("KO") or 
		gameStatus:GetAttribute("Punch") or gameStatus:GetAttribute("Rez") or gameStatus:GetAttribute("Rezzing") 
	then return end
	local ally = gameStatus:FindFirstChild("Ally").Value
	if not ally:FindFirstChild("GameStatus"):GetAttribute("KO") or ally:FindFirstChild("GameStatus"):GetAttribute("Rezzing") then return end
	events:FindFirstChild("Rez"):FireServer(ally)
end
