local function dashSetup()
	local humRP = plyr.Character:FindFirstChild("HumanoidRootPart")
	local rayPart = Instance.new("Part")
	rayPart.Name = "RayPart"
	rayPart.Parent = plyr.Character
	rayPart.CanCollide = false
	rayPart.Massless = true
	rayPart.Transparency = 1
	local endPart = Instance.new("Part")
	endPart.Name = "EndPart"
	endPart.Parent = game.Workspace
	endPart.CanCollide = false
	endPart.Massless = true
	endPart.Transparency = 1
	endPart.Size = Vector3.new(3, 3, .1)
	endPart.CFrame = humRP.CFrame * CFrame.new(0, 0, -dashDistance)
	local weld1 = Instance.new("WeldConstraint")
	weld1.Parent = rayPart
	weld1.Part0 = humRP
	weld1.Part1 = rayPart
	local weld2 = Instance.new("WeldConstraint")
	weld2.Parent = endPart
	weld2.Part0 = humRP
	weld2.Part1 = endPart
	local rayPrm = RaycastParams.new()
	rayPrm.FilterDescendantsInstances = {plyr.Character}
	rayPrm.FilterType = Enum.RaycastFilterType.Exclude
	return rayPart, weld1, rayPrm, endPart
end

local function changeRayPart(origin, result, rayPart, x, y)
	local distance = (origin - result.Position).Magnitude
	rayPart.Size = Vector3.new(x, y, distance)
	rayPart.CFrame = CFrame.lookAt(origin, result.Position) * CFrame.new(0, 0, -distance/2)
end

local function getDashTarget(rayPart, weld1, rayPrm, endPart)
	local char = plyr.Character
	local dashTarget = char:FindFirstChild("GameStatus"):FindFirstChild("Dash")
	local origin = char:FindFirstChild("HumanoidRootPart").CFrame.Position
	local result = game.Workspace:Raycast(origin, camera.CFrame.LookVector * dashDistance, rayPrm)
	if not result then return end
	weld1.Enabled = false
	local function areaCheck()
		local plyrsIn = potentialTargets(rayPart)
		if #plyrsIn == 0 then
			dashTarget.Value = nil
		elseif #plyrsIn == 1 then
			dashTarget.Value = plyrsIn[1]
		else
			for i,v in pairs(plyrsIn) do
				setTarget(dashTarget, v)
			end
		end
	end
	if result.Instance == endPart then
		changeRayPart(origin, result, rayPart, 20, 5)
		areaCheck()
	else
		if result.Instance.Parent:FindFirstChild("HumanoidRootPart") ~= nil then
			changeRayPart(origin, result, rayPart, .1, .1)
			dashTarget.Value =  result.Instance.Parent
		elseif result.Instance.Parent.Parent:FindFirstChild("HumanoidRootPart") ~= nil then
			changeRayPart(origin, result, rayPart, .1, .1)
			dashTarget.Value =  result.Instance.Parent.Parent
		else
			changeRayPart(origin, result, rayPart, 20, 5)
			areaCheck()
		end
	end
	weld1.Enabled = true
	if dashTarget.Value ~= nil then
		bGUI.Parent = dashTarget.Value
		if plyr:DistanceFromCharacter(char:FindFirstChild("GameStatus"):FindFirstChild("Dash").Value.PrimaryPart.CFrame.Position) < 5 then
			char:FindFirstChild("AlignPosition").Enabled = false
			char:FindFirstChild("LinearVelocity").Enabled = true
			char:FindFirstChild("GameStatus"):SetAttribute("Dash", false)
		end
	else
		bGUI.Parent = script
		char:FindFirstChild("AlignPosition").Attachment1 = nil
		char:FindFirstChild("AlignPosition").Enabled = false
		char:FindFirstChild("LinearVelocity").Enabled = true
		char:FindFirstChild("GameStatus"):SetAttribute("Dash", false)
	end
end


local function dash(event, inputState, inputObj)
	local char = plyr.Character
	if inputState ~= Enum.UserInputState.Begin or char:FindFirstChild("GameStatus"):GetAttribute("KO") or char:FindFirstChild("GameStatus"):GetAttribute("Rez") or 
		char:FindFirstChild("GameStatus"):GetAttribute("Rezzing") then
		char:FindFirstChild("AlignPosition").Enabled = false
		char:FindFirstChild("LinearVelocity").Enabled = true
		char:FindFirstChild("GameStatus"):SetAttribute("Dash", false)
		return
	else
		if char:FindFirstChild("GameStatus"):FindFirstChild("Dash").Value == nil then return end
		char:FindFirstChild("AlignPosition").Attachment1 = char:FindFirstChild("GameStatus"):FindFirstChild("Dash").Value:FindFirstChild("HumanoidRootPart"):FindFirstChild("RootAttachment")
		char:FindFirstChild("AlignPosition").Enabled = true
		char:FindFirstChild("LinearVelocity").Enabled = false
		char:FindFirstChild("GameStatus"):SetAttribute("Dash", true)
	end
end
