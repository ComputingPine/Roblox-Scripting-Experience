local function getControls()
	cAS:BindAction("Punch", punch, true, Enum.KeyCode.F)
	cAS:BindAction("Rez", rez, true, Enum.KeyCode.E)
	cAS:BindAction("Dash", dash, true, Enum.KeyCode.LeftShift)
end

local function stopControls()
	cAS:UnbindAction("Punch")
	cAS:UnbindAction("Rez")
	cAS:UnbindAction("Dash")
end

function module.startGame()
	getControls()
	local part = hitBox()
	local rayPart, weld1, rayPrm, endPart = dashSetup()
	rS:BindToRenderStep("GetTargets", 1, function()
		getTargets(part)
		getDashTarget(rayPart, weld1, rayPrm, endPart)
	end)
end

function module.stopGame()
	stopControls()
	rS:UnbindFromRenderStep("GetTargets")
end

return module
